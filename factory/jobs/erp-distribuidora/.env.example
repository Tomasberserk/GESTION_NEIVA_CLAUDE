# ──────────────────────────────────────────────────────────────────────────────
# ERP Distribuidora — Variables de entorno
# Copia este archivo a .env y completa tus valores reales.
# NUNCA commitees el archivo .env al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=erp_distribuidora
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=cambia_esta_clave_segura

# URL completa (usada por el backend en Docker)
# Para desarrollo local (sin Docker), reemplaza "db" con "localhost" o "127.0.0.1"
DATABASE_URL=postgresql://erp_user:cambia_esta_clave_segura@db:5432/erp_distribuidora

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_de_64_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Separados por comas, sin espacios
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8001
