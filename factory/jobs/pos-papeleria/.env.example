# ──────────────────────────────────────────────────────────────────────────────
# POS Papelería — Variables de entorno
# Copia este archivo a .env y completa tus valores reales.
# NUNCA commitees el archivo .env al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=pos_papeleria
POSTGRES_USER=papeleria_user
POSTGRES_PASSWORD=cambia_esta_clave_segura

# URL completa (usada por el backend)
DATABASE_URL=postgresql://papeleria_user:cambia_esta_clave_segura@db:5432/pos_papeleria

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_de_64_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Separados por comas, sin espacios
CORS_ORIGINS=http://localhost:5173,https://tu-dominio.com

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Almacenamiento ────────────────────────────────────────────────────────────
UPLOAD_DIR=media

# ── Modo debug (false en producción) ─────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
