# Database and Cache Configuration
DATABASE_URL=postgresql://gestion_user:gestion_pass@localhost:5432/gestion_neiva
ASYNC_DATABASE_URL=postgresql+asyncpg://gestion_user:gestion_pass@localhost:5432/gestion_neiva
REDIS_URL=redis://localhost:6379/0

# Application Security & JWT
SECRET_KEY=replace-with-64-char-hex-secret-in-production-environment-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
SUPERADMIN_KEY=replace-with-secure-superadmin-header-key

# Runtime & CORS
ENVIRONMENT=development
DEBUG=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,https://gestion-neiva-claude.vercel.app
UPLOAD_DIR=media

# AI Providers (Voice & Conversational Assistant)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-cloud-api-key
